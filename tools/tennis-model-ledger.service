[Unit]
Description=Tennis full-signal ledger (model probability vs market price)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pmbot
WorkingDirectory=/opt/pmbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pmbot/.venv/bin/python tools/tennis_model_ledger.py --interval 15
Restart=always
RestartSec=10
StandardOutput=append:/opt/pmbot/logs/tennis_model_ledger.out.log
StandardError=append:/opt/pmbot/logs/tennis_model_ledger.err.log

[Install]
WantedBy=multi-user.target
