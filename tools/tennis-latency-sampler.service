[Unit]
Description=Tennis data-source race sampler (ESPN vs Polymarket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pmbot
WorkingDirectory=/opt/pmbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pmbot/.venv/bin/python tools/tennis_latency_sampler.py --interval 2
Restart=always
RestartSec=10
StandardOutput=append:/opt/pmbot/logs/tennis_sampler.out.log
StandardError=append:/opt/pmbot/logs/tennis_sampler.err.log

[Install]
WantedBy=multi-user.target
