PM_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
PM_PRIVATE_KEY=
PM_API_KEY=your_polymarket_api_key
PM_API_SECRET=your_polymarket_api_secret
PM_API_PASSPHRASE=your_polymarket_api_passphrase

# Stage 2 live execution safety switches
LIVE_EXECUTION_ENABLED=0
LIVE_GLOBAL_ENABLED=0
LIVE_UNATTENDED_ENABLED=1
LIVE_ALLOWED_SPORTS=MLB,NBA
LIVE_MAX_ORDER_SIZE_USDC=50
LIVE_MAX_DAILY_SPEND_USDC=100
LIVE_MAX_DAILY_LOSS_USDC=100
LIVE_ORDER_TIMEOUT_SECONDS=45
LIVE_MIN_ORDER_SIZE_USDC=5
LIVE_ABNORMAL_PAUSE_ENABLED=1
LIVE_MAX_BOOK_AGE_SECONDS=30
LIVE_MAX_BOOK_SPREAD=0.20
PM_SIGNATURE_TYPE=1

# 代理（唯一来源，aiohttp/httpx 共用）：
#   本地国内走 Clash → PM_PROXY_URL=http://127.0.0.1:7897
#   海外 VPS 直连     → 留空或删掉这一行（不设 = 不使用代理）
PM_PROXY_URL=http://127.0.0.1:7897

# 演练 / 干跑：验证「信号 → 下单」链路，不产生真实资金变动
# SIGNAL_DRILL_MODE=1 会放宽信号阈值并允许同一场比赛按冷却时间重复触发；
# 开启后自动强制 LIVE_DRY_RUN=1（只签名不提交）。
SIGNAL_DRILL_MODE=0
SIGNAL_DRILL_COOLDOWN_SECONDS=60
# 事件驱动：实时流收到状态变化立即评估信号，不等主循环（默认开启）
SIGNAL_EVENT_DRIVEN=1
# 市场预匹配：提前把 gameId → token 映射与订单元数据准备好（默认开启）
PREMATCH_ENABLED=1
# 主循环轮询间隔（秒）。缩短可降低信号识别延迟，但会增加上游请求量
NBA_POLL_INTERVAL=3
# MLB 数据源：statsapi（官方，默认）| espn
MLB_FEED_SOURCE=statsapi
# LIVE_DRY_RUN=1 单独使用也可：走完校验并签名，但不提交订单
LIVE_DRY_RUN=0
# PM 实时流覆盖层：用 Polymarket 推送流加速 MLB/NBA/WNBA 的比分更新
# 覆盖前必须先与轮询源比分逐队一致过一次（详见 src/sports_overlay.py）
PM_STREAM_OVERLAY=1
# 走 PM 实时流加速的运动（校验通过后才生效，失败即回退 ESPN 轮询）
PM_STREAM_OVERRIDE_SPORTS=MLB,NBA,WNBA,NFL,CFB,NHL,TENNIS
PM_STREAM_STALE_SECONDS=90
# 实盘对账：用交易所只读数据修正本地幽灵 OPEN 记录（默认开启）
LIVE_RECONCILE_ENABLED=1
# 本地 OPEN 在交易所持仓与已结算里都查不到时，超过多少小时释放持仓额度
LIVE_RECONCILE_ORPHAN_HOURS=12
# 只读账户接口重试：出口抖动时同一次刷新内重试，避免面板整分钟把抖动显示成报错
# LIVE_FETCH_ATTEMPTS=3
# LIVE_FETCH_RETRY_DELAY_SECONDS=0.4
# 当日额度 / 当日盈亏的换日时区（默认北京时间 0 点重置；改成 UTC 则 8 点重置）
DAILY_RESET_TZ=Asia/Shanghai
# 持久化体积控制（留空用默认值）
# LOG_MAX_BYTES=5242880          # bot.log 单份上限，超过就轮转
# LOG_BACKUP_COUNT=5             # 保留的轮转份数
# LIVE_HISTORY_MAX_BYTES=5242880 # 实盘权益采样日志归档阈值
# LIVE_HISTORY_BACKUP_COUNT=3
# LIVE_HISTORY_LOAD_LINES=20000  # 启动时只读最近多少行
# LIVE_STATE_COMPACT_LINES=2000  # 实盘状态快照超过多少行自动压缩
# PAPER_SIGNAL_LOG_LIMIT=500     # state.json 里保留的信号条数
# PAPER_EQUITY_HISTORY_LIMIT=5000

# 持仓期间盘口采集（只读）：给止损策略复核攒「真实买一价」
# 背景见 PROJECT_DESIGN.md 11.7 —— 分钟中间价回答不了「挂单到底成不成交」
POSITION_PATH_ENABLED=1
# POSITION_PATHS_PATH=trades/position_paths.jsonl
# POSITION_PATH_INTERVAL_SECONDS=8   # 每个持仓多久采一条（最小 2 秒）
# POSITION_PATH_MAX_CONCURRENT=4     # 同时抓几个盘口
# POSITION_PATH_MAX_BYTES=33554432   # 单份文件上限，超过就轮转
# POSITION_PATH_BACKUP_COUNT=2

# 决胜盘平分影子仓：只记录，不提交订单
TENNIS_TIE_SHADOW_ENABLED=1
# TENNIS_TIE_SHADOW_PATH=trades/tennis_tie_shadow.jsonl
# TENNIS_TIE_SHADOW_STAKE_USDC=1.0
# TENNIS_TIE_SHADOW_FEE_RATE=0.05
# TENNIS_TIE_SHADOW_RECONCILE_INTERVAL_SECONDS=300
# TENNIS_TIE_SHADOW_RECONCILE_MIN_AGE_SECONDS=300
# TENNIS_TIE_SHADOW_MAX_BYTES=33554432
# TENNIS_TIE_SHADOW_BACKUP_COUNT=10
# 决胜盘平分事件级链路账本（比分变化→盘口→发单→成交）
TENNIS_TIE_EVENTS_ENABLED=1
# TENNIS_TIE_EVENTS_PATH=trades/tennis_tie_events.jsonl
# TENNIS_TIE_EVENTS_MAX_BYTES=33554432
# TENNIS_TIE_EVENTS_BACKUP_COUNT=8
# 决胜盘每个平分状态尝试买入的目标份额（当前为 1 份，不再按 min_order_size 抬高）
TENNIS_TIE_LIVE_ENABLED=1
# TENNIS_TIE_LIVE_ORDER_USDC=1.10

# CS2 决胜图平分影子仓（只记录，不提交订单）
CS2_TIE_SHADOW_ENABLED=1
# CS2_TIE_SHADOW_PATH=trades/cs2_tie_shadow.jsonl
# CS2_TIE_SHADOW_STAKE_USDC=1.0
# CS2_TIE_SHADOW_FEE_RATE=0.05
# CS2_TIE_SHADOW_MAX_ROUND_SCORE=12
# CS2_TIE_SHADOW_RECONCILE_INTERVAL_SECONDS=300
# CS2_TIE_SHADOW_RECONCILE_MIN_AGE_SECONDS=300
# CS2_TIE_SHADOW_MAX_BYTES=33554432
# CS2_TIE_SHADOW_BACKUP_COUNT=10

# API-Tennis 只读延迟采样器（不要提交真实 key 到仓库）
# APITENNIS_KEY=
# APITENNIS_SHADOW_ENABLED=1
# APITENNIS_SHADOW_STAKE_USDC=2.0
# APITENNIS_SHADOW_EXIT_SECONDS=180
# APITENNIS_SHADOW_FEE_RATE=0.05

# Dashboard safety control. Never commit the real password.
LIVE_MODE_PASSWORD=

# Optional
PM_BALANCE_DECIMALS=6
